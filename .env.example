# 复制为 .env 后填写，供 scripts/auto-species.mjs 在本地使用。.env 已被 .gitignore 忽略，不会提交。
# 任何 OpenAI 兼容的 Chat Completions 接口都可以，常见平台的地址见 README。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 模型不支持 JSON 输出模式（response_format: json_object）时取消注释
# LLM_JSON_MODE=off

# 每次调用模型最多等待的秒数，默认 300。免费模型要排队、推理模型要先思考，可适当调大
# LLM_TIMEOUT=600

# 默认不运行第二轮 AI 检查；需要时设为 on。它使用同一批参考资料，不能代替人工审核
# LLM_REVIEW_MODEL=deepseek-reasoner
# LLM_REVIEW=on

# 输出长度上限（token）。不设置时由平台决定；报错 "ran out of output tokens" 时再调大。推理模型的思考也计入这个上限
# LLM_MAX_TOKENS=8192
